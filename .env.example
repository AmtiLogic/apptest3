# REQUIRED in production. Encrypts the session cookie that holds your Garmin
# token. Without it the app refuses to start serving requests, because sessions
# would break as soon as the host runs more than one instance.
# Generate one with:  openssl rand -base64 32
APP_SECRET=

# Optional. Set to 1 to run the app against built-in fixture data without ever
# contacting Garmin -- useful for working on the UI, or for seeing what the app
# does before handing it real credentials.
GARMIN_MOCK=0

# Optional. Garmin's Chinese platform uses garmin.cn.
GARMIN_DOMAIN=garmin.com

# Optional. The mobile-client OAuth credentials are fetched at runtime; set
# these to pin them instead.
# GARMIN_CONSUMER_KEY=
# GARMIN_CONSUMER_SECRET=
